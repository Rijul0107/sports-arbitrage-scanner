<?xml version="1.0" encoding="UTF-8"?>
<!--
  Keeps bot.py running so replies to alerts get answered.

     NOTE: launchd and cron both require ABSOLUTE paths and neither expands
     ~ or $HOME. Replace every /ABSOLUTE/PATH/TO/arb-desk below with wherever you
     cloned the repo, e.g. with:
       sed -i '' "s#/ABSOLUTE/PATH/TO/arb-desk#$PWD#g" deploy/*.plist deploy/crontab.txt

  Install:
    cp deploy/com.arbdesk.bot.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.arbdesk.bot.plist

  Stop:
    launchctl unload ~/Library/LaunchAgents/com.arbdesk.bot.plist

  KeepAlive restarts it if it dies or the machine reboots. It spends no API
  credits — it only recomputes stakes from prices already sent — so a restart
  loop costs nothing but log noise.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.arbdesk.bot</string>

    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/python3</string>
        <string>/ABSOLUTE/PATH/TO/arb-desk/bot.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/ABSOLUTE/PATH/TO/arb-desk</string>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <!-- Long-poll holds a connection for ~50s at a time; throttle restarts so a
         misconfiguration cannot spin. -->
    <key>ThrottleInterval</key>
    <integer>30</integer>

    <key>StandardOutPath</key>
    <string>/ABSOLUTE/PATH/TO/arb-desk/bot.log</string>
    <key>StandardErrorPath</key>
    <string>/ABSOLUTE/PATH/TO/arb-desk/bot.log</string>
</dict>
</plist>
